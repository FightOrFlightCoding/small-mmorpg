{
  "name": "vibecode-content-build",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/tests",
    "generate": "tsc -p tsconfig.json && node dist/src/cli.js generate",
    "diff": "tsc -p tsconfig.json && node dist/src/cli.js diff",
    "trace": "tsc -p tsconfig.json && node dist/src/cli.js trace"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "ajv": "8.17.1",
    "typescript": "5.8.3"
  }
}
