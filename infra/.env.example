# Local Nakama Console uses Nakama's built-in development defaults.
# Open http://127.0.0.1:7351
# Username: admin
# Password: password
#
# Those values are Heroic Labs insecure local defaults, not project production secrets.
# Do not put production credentials in this repository.
# Copy to infra/.env (gitignored) only if a later phase wires overrides.
# Local Compose reads infra/.env.local for SendGrid (see .env.local.example).
