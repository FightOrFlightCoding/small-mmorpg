# Copy to infra/.env.local (gitignored). Local Compose still uses docker-compose.yml defaults
# unless you switch to an env_file overlay. Do not put production secrets here.

POSTGRES_PASSWORD=localdb
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=password

# Auth gateway (safe local values; also hardcoded in docker-compose.yml for Compose defaults)
AUTH_GATEWAY_ENV=local
AUTH_GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:8787
EMAIL_PROVIDER=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_HEALTH_URL=http://127.0.0.1:8025/api/v1/info
NAKAMA_HTTP_URL=http://127.0.0.1:7350
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_HTTP_KEY=defaulthttpkey
VIBECODE_EMAIL_HMAC_PEPPER=local-email-hmac-pepper-not-production
VIBECODE_GATEWAY_HMAC_SECRET=local-gateway-hmac-secret-not-production
VIBECODE_CHALLENGE_HMAC_SECRET=local-challenge-hmac-secret-not-production
EMAIL_FROM=Vibecode <no-reply@localhost>
EMAIL_SUPPORT_ADDRESS=support@localhost
