# Copy to infra/.env.local (gitignored). Local Compose reads this file for SendGrid.
# Do not commit the copied file. Do not put production HMAC secrets here.

POSTGRES_PASSWORD=localdb
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=password

# Auth gateway
AUTH_GATEWAY_ENV=local
AUTH_GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:8787
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=REPLACE_ME
# Must be a sender SendGrid has verified (single sender or authenticated domain).
EMAIL_FROM="Vibecode <no-reply@REPLACE_ME>"
EMAIL_SUPPORT_ADDRESS=support@REPLACE_ME
NAKAMA_HTTP_URL=http://127.0.0.1:7350
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_HTTP_KEY=defaulthttpkey
VIBECODE_EMAIL_HMAC_PEPPER=local-email-hmac-pepper-not-production
VIBECODE_GATEWAY_HMAC_SECRET=local-gateway-hmac-secret-not-production
VIBECODE_CHALLENGE_HMAC_SECRET=local-challenge-hmac-secret-not-production
AUTH_REGISTRATION_MODE=OPEN
AUTH_TERMS_VERSION=1
AUTH_PRIVACY_VERSION=1
AUTH_MIN_CLIENT_VERSION=1.0.0
AUTH_MAX_CLIENT_VERSION=1.0.0
AUTH_VERIFICATION_TTL_MS=1800000
AUTH_UNVERIFIED_RETENTION_MS=604800000
AUTH_LOGOUT_ALL_RECENT_MS=300000
AUTH_PASSWORD_RESET_TTL_MS=900000
AUTH_EMAIL_CHANGE_TTL_MS=900000
AUTH_SENSITIVE_RECENT_MS=900000
AUTH_RESET_UNIFORM_MS=150
AUTH_SUPPORT_LOOKUP_SECRET=local-support-lookup-secret
# AUTH_REGISTRATION_ALLOWLIST=allowed@example.com
