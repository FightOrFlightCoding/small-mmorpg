# Copy to infra/.env.staging (gitignored). Replace every REPLACE_ME before starting staging.
# Never commit the copied file. Public auth URLs must be HTTPS.

POSTGRES_PASSWORD=REPLACE_ME
NAKAMA_CONSOLE_USERNAME=REPLACE_ME
NAKAMA_CONSOLE_PASSWORD=REPLACE_ME
NAKAMA_SERVER_KEY=REPLACE_ME
NAKAMA_HTTP_KEY=REPLACE_ME
AUTH_GATEWAY_ENV=staging
AUTH_GATEWAY_PUBLIC_BASE_URL=https://REPLACE_ME
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=REPLACE_ME
EMAIL_FROM=Vibecode <no-reply@REPLACE_ME>
EMAIL_SUPPORT_ADDRESS=support@REPLACE_ME
VIBECODE_EMAIL_HMAC_PEPPER=REPLACE_ME
VIBECODE_GATEWAY_HMAC_SECRET=REPLACE_ME
VIBECODE_CHALLENGE_HMAC_SECRET=REPLACE_ME
