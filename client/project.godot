; Engine configuration file.
; Compatibility spike for the pinned Godot 4.7.1 client stack.
config_version=5

[application]

config/name="small-mmorpg"
config/description="Pinned-stack compatibility spike. No gameplay scenes."
run/main_scene="res://scenes/compatibility_check.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/gloot/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
