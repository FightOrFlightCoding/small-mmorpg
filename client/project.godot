; Engine configuration file.
; Godot 4.7.1 client. Authenticates, bootstraps one character, joins the starter zone.
config_version=5

[application]

config/name="small-mmorpg"
config/description="Client. Device auth, one character, content-driven starter zone. No movement."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AppState="*res://scripts/app/app_state.gd"
ContentRegistry="*res://scripts/content/content_registry.gd"
NetworkService="*res://scripts/network/network_service.gd"
GameService="*res://scripts/game/game_service.gd"
SceneRouter="*res://scripts/routing/scene_router.gd"
Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/gloot/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
