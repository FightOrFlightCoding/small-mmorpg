[node name="Warning" type="Label" parent="Center/VBox"]
layout_mode = 2
text = "This permanently deletes the account. All five character slots, live and recently deleted characters, inventory, equipment, gold, quests, settings, and party history are removed and cannot be restored. After deletion the email can be used only to register a new blank account."
