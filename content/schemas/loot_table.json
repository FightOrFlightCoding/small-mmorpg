{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecode.local/content-schemas/loot_table.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "displayName", "ownershipPolicy", "entries"],
  "properties": {
    "id": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
    "kind": { "const": "loot_table" },
    "displayName": { "type": "string", "minLength": 1 },
    "ownershipPolicy": {
      "type": "string",
      "enum": ["ground_free", "killer", "party_split"]
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/lootTableEntry" }
    },
    "schemaVersion": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/definitionSchemaVersion" },
    "developmentOnly": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/developmentOnly" }
  }
}
