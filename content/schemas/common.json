{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecode.local/content-schemas/common.json",
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$"
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "vec2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "aabb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "$ref": "#/$defs/positiveNumber" },
        "height": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "definitionSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "developmentOnly": {
      "type": "boolean"
    },
    "itemStack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "quantity"],
      "properties": {
        "itemId": { "$ref": "#/$defs/contentId" },
        "quantity": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "itemStatModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statId", "amount"],
      "properties": {
        "statId": { "$ref": "#/$defs/contentId" },
        "amount": { "type": "number" }
      }
    },
    "resourceCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "amount"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/contentId" },
        "amount": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "magnitudeFormula": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["constant", "stat_role", "stat_id"]
        },
        "value": { "type": "number" },
        "role": {
          "type": "string",
          "enum": ["attack", "max_health", "max_mana", "generic"]
        },
        "statId": { "$ref": "#/$defs/contentId" },
        "scale": { "type": "number" }
      }
    },
    "contentClassification": {
      "type": "string",
      "enum": ["canonical", "compile-time-addition"]
    },
    "effectCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "target_relation",
            "target_health_percent",
            "target_has_tag",
            "source_has_tag",
            "shield_event",
            "standing_still",
            "no_enemy_in_range",
            "effect_active",
            "resource_percent"
          ]
        },
        "relation": {
          "type": "string",
          "enum": ["hostile", "friendly", "self", "any"]
        },
        "comparison": {
          "type": "string",
          "enum": ["below", "above", "at_or_below", "at_or_above"]
        },
        "value": { "type": "number" },
        "tag": { "type": "string", "minLength": 1 },
        "effectId": { "$ref": "#/$defs/contentId" },
        "event": {
          "type": "string",
          "enum": ["break", "expire"]
        },
        "range": { "$ref": "#/$defs/nonNegativeNumber" },
        "duration": { "$ref": "#/$defs/nonNegativeNumber" }
      }
    },
    "talentPrerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "minRank"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/contentId" },
        "minRank": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "talentModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ability_damage_percent",
            "ability_heal_percent",
            "ability_absorb_percent",
            "ability_duration",
            "ability_cast_time",
            "ability_channel_time",
            "ability_cooldown",
            "ability_range_percent",
            "ability_radius_percent",
            "ability_mana_cost_percent",
            "ability_hit_count",
            "ability_stun_duration",
            "ability_root_duration",
            "ability_slow_duration",
            "ability_slow_percent",
            "ability_crit_chance_flat",
            "max_hp_flat",
            "max_hp_percent",
            "auto_attack_damage_percent",
            "damage_reduction_percent",
            "damage_dealt_percent",
            "damage_taken_percent",
            "reflect_melee_percent",
            "cooldown_recovery_percent",
            "crit_damage_flat",
            "crit_chance_flat",
            "move_speed_percent",
            "mana_cost_percent",
            "mana_regen_flat",
            "heal_done_percent",
            "attack_speed_percent",
            "frenzy_max_stacks",
            "frenzy_per_stack_percent",
            "grant_ability",
            "on_shield_break_heal_percent",
            "dot_tick_rate_percent",
            "lifesteal_percent",
            "mana_refund_percent_of_max",
            "propagate_effect"
          ]
        },
        "abilityId": { "$ref": "#/$defs/contentId" },
        "value": { "type": "number" },
        "grantsAbilityId": { "$ref": "#/$defs/contentId" },
        "effectId": { "$ref": "#/$defs/contentId" }
      }
    },
    "statMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stat.strength",
        "stat.agility",
        "stat.intelligence",
        "stat.spirit",
        "stat.vitality",
        "stat.precision",
        "stat.haste",
        "stat.endurance"
      ],
      "properties": {
        "stat.strength": { "type": "number" },
        "stat.agility": { "type": "number" },
        "stat.intelligence": { "type": "number" },
        "stat.spirit": { "type": "number" },
        "stat.vitality": { "type": "number" },
        "stat.precision": { "type": "number" },
        "stat.haste": { "type": "number" },
        "stat.endurance": { "type": "number" }
      }
    },
    "abilityEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source",
        "target",
        "magnitude",
        "duration",
        "tickInterval",
        "stackPolicy",
        "maxStacks",
        "refreshPolicy",
        "removalReason",
        "tags"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "direct_damage",
            "direct_heal",
            "resource_change",
            "timed_stat_modifier",
            "periodic_damage",
            "periodic_heal",
            "stun",
            "root",
            "taunt",
            "interrupt",
            "slow",
            "shield",
            "movement",
            "reflect_damage",
            "propagate_effect",
            "cooldown_reset_on_kill",
            "guaranteed_crit",
            "passive_stacker"
          ]
        },
        "source": {
          "type": "string",
          "enum": ["caster"]
        },
        "target": {
          "type": "string",
          "enum": ["primary", "area", "self"]
        },
        "magnitude": { "$ref": "#/$defs/magnitudeFormula" },
        "duration": { "$ref": "#/$defs/nonNegativeNumber" },
        "tickInterval": { "$ref": "#/$defs/nonNegativeNumber" },
        "stackPolicy": {
          "type": "string",
          "enum": ["replace", "refresh", "stack", "ignore"]
        },
        "maxStacks": { "$ref": "#/$defs/positiveInteger" },
        "refreshPolicy": {
          "type": "string",
          "enum": ["refresh", "extend", "ignore"]
        },
        "removalReason": {
          "type": "string",
          "enum": ["expired", "dispelled", "death", "replaced"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "statChannel": { "type": "string", "minLength": 1 },
        "resourceRole": {
          "type": "string",
          "enum": ["health", "mana", "generic"]
        },
        "school": {
          "type": "string",
          "enum": ["melee", "ranged", "spell", "heal", "none"]
        },
        "delay": { "$ref": "#/$defs/nonNegativeNumber" },
        "hitCount": { "$ref": "#/$defs/positiveInteger" },
        "independentCrit": { "type": "boolean" },
        "guaranteedCrit": { "type": "boolean" },
        "cooldownResetOnKill": { "type": "boolean" },
        "reflectFraction": { "type": "number" },
        "movementKind": {
          "type": "string",
          "enum": ["leap", "dash"]
        },
        "movementDistance": { "$ref": "#/$defs/nonNegativeNumber" },
        "propagateOn": {
          "type": "string",
          "enum": ["death", "shield_break", "shield_expire"]
        },
        "propagateEffectId": { "$ref": "#/$defs/contentId" },
        "shieldBreakHealRatio": { "type": "number" },
        "healthPercent": { "type": "number" },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/effectCondition" }
        },
        "classification": { "$ref": "#/$defs/contentClassification" },
        "compileTimeAddition": { "type": "boolean" }
      }
    },
    "lootTableEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemDefinitionId", "minimumQuantity", "maximumQuantity", "chance"],
      "properties": {
        "itemDefinitionId": { "$ref": "#/$defs/contentId" },
        "minimumQuantity": { "$ref": "#/$defs/positiveInteger" },
        "maximumQuantity": { "$ref": "#/$defs/positiveInteger" },
        "chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "weight": { "$ref": "#/$defs/nonNegativeNumber" },
        "groupId": { "type": "string", "minLength": 1 },
        "guaranteed": { "type": "boolean" },
        "ownershipPolicy": {
          "type": "string",
          "enum": ["ground_free", "killer", "party_split"]
        }
      }
    },
    "enemyResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "max"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/contentId" },
        "max": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "bossPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "healthPercentAtOrBelow": { "type": "number", "minimum": 0, "maximum": 100 },
        "combatTimeSecAtOrAbove": { "$ref": "#/$defs/nonNegativeNumber" },
        "addDeathsAtOrAbove": { "$ref": "#/$defs/nonNegativeInteger" },
        "requireFlag": { "type": "string", "minLength": 1 },
        "setFlag": { "type": "string", "minLength": 1 },
        "addAbilityIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/contentId" }
        },
        "removeAbilityIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/contentId" }
        },
        "moveSpeed": { "$ref": "#/$defs/positiveNumber" },
        "aggroRadius": { "$ref": "#/$defs/positiveNumber" },
        "attackRange": { "$ref": "#/$defs/positiveNumber" },
        "triggerSpawnId": { "$ref": "#/$defs/contentId" },
        "combatMessage": { "type": "string", "minLength": 1 },
        "applyEffect": { "$ref": "#/$defs/abilityEffect" }
      }
    },
    "statComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer"],
      "properties": {
        "layer": {
          "type": "string",
          "enum": [
            "class_base",
            "level_growth",
            "allocated_attributes",
            "equipment",
            "effects",
            "percent",
            "multiply",
            "clamp"
          ]
        },
        "source": {
          "type": "string",
          "enum": ["starting_derived", "starting_resource", "attribute_growth", "resource_growth", "constant"]
        },
        "id": { "$ref": "#/$defs/contentId" },
        "channel": { "type": "string", "minLength": 1 },
        "weight": { "type": "number" },
        "value": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    }
  }
}
