{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecode.local/content-schemas/vendor.json",
  "title": "vendor_definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "displayName", "currencyId", "stock", "sellMultiplier"],
  "properties": {
    "id": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
    "kind": { "const": "vendor" },
    "displayName": { "type": "string", "minLength": 1 },
    "currencyId": { "const": "gold" },
    "stock": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "buyPrice"],
        "properties": {
          "itemId": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
          "buyPrice": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/nonNegativeInteger" },
          "stockEntryId": { "type": "string", "minLength": 1 },
          "displayOrder": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/nonNegativeInteger" },
          "quantityConstraints": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": { "type": "integer", "minimum": 1, "maximum": 99 },
              "max": { "type": "integer", "minimum": 1, "maximum": 99 }
            }
          },
          "classRequirements": {
            "type": "array",
            "items": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" }
          },
          "levelRequirement": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/nonNegativeInteger" }
        }
      }
    },
    "sellMultiplier": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/nonNegativeNumber" },
    "schemaVersion": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/definitionSchemaVersion" },
    "developmentOnly": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/developmentOnly" }
  }
}
