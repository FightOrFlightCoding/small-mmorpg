{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecode.local/content-schemas/item.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "displayName", "visualId", "maxStack", "attackBonus"],
  "properties": {
    "id": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
    "kind": { "const": "item" },
    "displayName": { "type": "string", "minLength": 1 },
    "visualId": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
    "maxStack": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/positiveInteger" },
    "equipSlot": { "type": "string", "minLength": 1 },
    "attackBonus": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/nonNegativeNumber" }
  }
}
