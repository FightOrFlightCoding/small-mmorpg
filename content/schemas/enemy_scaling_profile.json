{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecode.local/content-schemas/enemy_scaling_profile.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "displayNameKey",
    "hpIntercept",
    "hpPerLevel",
    "damageIntercept",
    "damagePerLevel",
    "swingInterval",
    "killXpIntercept",
    "killXpPerLevel",
    "hpMultiplier",
    "damageMultiplier",
    "killXpMultiplier"
  ],
  "properties": {
    "id": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
    "kind": { "const": "enemy_scaling_profile" },
    "displayName": { "type": "string", "minLength": 1 },
    "displayNameKey": { "type": "string", "minLength": 1 },
    "descriptionKey": { "type": "string", "minLength": 1 },
    "hpIntercept": { "type": "number" },
    "hpPerLevel": { "type": "number" },
    "damageIntercept": { "type": "number" },
    "damagePerLevel": { "type": "number" },
    "swingInterval": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/positiveNumber" },
    "killXpIntercept": { "type": "number" },
    "killXpPerLevel": { "type": "number" },
    "hpMultiplier": { "type": "number" },
    "damageMultiplier": { "type": "number" },
    "killXpMultiplier": { "type": "number" },
    "classification": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentClassification" },
    "compileTimeAddition": { "type": "boolean" },
    "schemaVersion": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/definitionSchemaVersion" },
    "developmentOnly": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/developmentOnly" }
  }
}
