{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecode.local/content-schemas/enemy.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "displayName",
    "displayNameKey",
    "visualId",
    "level",
    "maxHealth",
    "damage",
    "moveSpeed",
    "aggroRadius",
    "attackRange",
    "attackCooldown",
    "leashRadius",
    "respawnDelay",
    "abilityLoadout",
    "aiProfileId",
    "xpReward",
    "lootTableId",
    "collisionProfileId",
    "tags"
  ],
  "properties": {
    "id": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
    "kind": { "const": "enemy" },
    "displayName": { "type": "string", "minLength": 1 },
    "displayNameKey": { "type": "string", "minLength": 1 },
    "visualId": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
    "level": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/positiveInteger" },
    "maxHealth": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/positiveNumber" },
    "damage": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/nonNegativeNumber" },
    "defense": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/nonNegativeNumber" },
    "moveSpeed": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/positiveNumber" },
    "aggroRadius": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/positiveNumber" },
    "attackRange": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/positiveNumber" },
    "attackCooldown": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/positiveNumber" },
    "leashRadius": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/positiveNumber" },
    "respawnDelay": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/nonNegativeNumber" },
    "abilityLoadout": {
      "type": "array",
      "items": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" }
    },
    "aiProfileId": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
    "xpReward": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/nonNegativeInteger" },
    "lootTableId": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
    "collisionProfileId": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/enemyResource" }
    },
    "loot": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "quantity", "guaranteed"],
        "properties": {
          "itemId": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/contentId" },
          "quantity": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/positiveInteger" },
          "guaranteed": { "type": "boolean" }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/bossPhase" }
    },
    "schemaVersion": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/definitionSchemaVersion" },
    "developmentOnly": { "$ref": "https://vibecode.local/content-schemas/common.json#/$defs/developmentOnly" }
  }
}
