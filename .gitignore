.idea/
.vscode/
*.swp
*~

# Godot
client/.godot/
client/.import/
client/export/
client/exports/
client/.gdunit_report/
client/reports/
*.translation

# Engine-generated sidecars for vendored addons that omit them.
# Dialogue Manager 3.10.5 and GLoot 3.0.2 ship their own .uid/.import files; keep those.
client/addons/com.heroiclabs.nakama/**/*.uid
client/addons/gdUnit4/**/*.uid
client/addons/gdUnit4/**/*.import

# Node / TypeScript runtime
server/node_modules/
server/build/
server/dist/
server/dist-test/
npm-debug.log*

# Docker / local data
infra/**/.env
infra/**/*.local.env
**/*.log

# Generated content and tool output
content/generated/
tools/**/__pycache__/
tools/**/node_modules/

# Secrets
.env
.env.*
!.env.example
*.pem
credentials.json
