{
  "name": "vibecode-server",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests",
    "build": "rollup -c rollup.config.mjs",
    "migrate": "tsc -p tsconfig.cli.json && node dist-cli/cli/migrate.js",
    "cert": "tsc -p tsconfig.cli.json && node dist-cli/cli/cert.js"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^20.17.0",
    "nakama-runtime": "github:heroiclabs/nakama-common#v1.47.0",
    "rollup": "^4.46.2",
    "tslib": "^2.8.1",
    "typescript": "5.8.3"
  }
}
